---
import Base from '../layouts/Base.astro';
import { url } from '../utils/url';
import { getNotesWithWords } from '../utils/content';
import { COUNTER_URL } from '../utils/counter';
import Lucide from '../components/Lucide.astro';

const notes = await getNotesWithWords();
const totalWords = notes.reduce((sum, note) => sum + note.words, 0);
const averageWords = notes.length ? Math.round(totalWords / notes.length) : 0;
---

<Base title="统计" description="万数屋的访问量与字数统计。">
  <section class="reveal flex items-start gap-5">
    <div class="min-w-0 flex-1">
      <p class="kana mb-1">STATS · すうじ</p>
      <span class="pill"><Lucide name="chart" size={14} class="text-[#ff6f9c]" /> 统计</span>
      <h1 class="mt-3 font-cute text-[clamp(1.8rem,4vw,2.4rem)]">这间屋子的数据</h1>
      <p class="mt-3 text-[#574d5f]">来客多少，写了多少字，一目了然。</p>
    </div>
  </section>

  <section class="mt-8 grid grid-cols-3 gap-2.5 sm:gap-4">
    <div class="card p-3 text-center sm:p-6">
      <p class="text-[11px] text-[#7a6b74] sm:text-sm">总访问量</p>
      <p class="mt-2 font-cute text-xl text-[#ff5c8d] sm:text-4xl">
        <span data-counter="total">—</span>
      </p>
    </div>
    <div class="card p-3 text-center sm:p-6">
      <p class="text-[11px] text-[#7a6b74] sm:text-sm">本页访问</p>
      <p class="mt-2 font-cute text-xl text-[#33406e] sm:text-4xl">
        <span data-counter="page">—</span>
      </p>
    </div>
    <div class="card p-3 text-center sm:p-6">
      <p class="text-[11px] text-[#7a6b74] sm:text-sm">笔记篇数</p>
      <p class="mt-2 font-cute text-xl text-[#3f9c7c] sm:text-4xl">{notes.length}</p>
    </div>
  </section>

  <section class="reveal mt-12">
    <h2 class="sec-title">字数统计</h2>
    <p class="mt-2 text-sm text-[#574d5f]">一天一点，字是攒出来的。</p>

    <div class="mt-5 grid grid-cols-3 gap-2.5 sm:gap-4">
      <div class="card p-3 text-center sm:p-6">
        <p class="font-cute text-xl text-[#ff5c8d] sm:text-3xl">{totalWords.toLocaleString('zh-CN')}</p>
        <p class="mt-1 text-[11px] text-[#7a6b74] sm:text-sm">全站总字数</p>
      </div>
      <div class="card p-3 text-center sm:p-6">
        <p class="font-cute text-xl text-[#33406e] sm:text-3xl">{averageWords.toLocaleString('zh-CN')}</p>
        <p class="mt-1 text-[11px] text-[#7a6b74] sm:text-sm">平均每篇</p>
      </div>
      <div class="card p-3 text-center sm:p-6">
        <p class="font-cute text-xl text-[#3f9c7c] sm:text-3xl">{notes.length}</p>
        <p class="mt-1 text-[11px] text-[#7a6b74] sm:text-sm">笔记篇数</p>
      </div>
    </div>

    <div class="card mt-5 overflow-hidden">
      <table class="w-full text-sm">
        <thead class="bg-[#fff7fa] text-[#574d5f]">
          <tr>
            <th class="px-5 py-3 text-left font-normal">篇目</th>
            <th class="px-5 py-3 text-right font-normal">字数</th>
          </tr>
        </thead>
        <tbody>
          {
            notes.map((note) => (
              <tr class="border-t border-[#f2e2d6]">
                <td class="px-5 py-3">{note.data.title}</td>
                <td class="px-5 py-3 text-right text-[#7a6b74]">{note.words}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </section>

  <script is:inline define:vars={{ COUNTER_URL }}>
    (() => {
      const TIMEOUT = 3000;
      const els = document.querySelectorAll('[data-counter]');
      els.forEach(async (el) => {
        const path = el.getAttribute('data-counter') === 'total' ? '/wanshu/' : location.pathname;
        const controller = new AbortController();
        const timer = setTimeout(() => controller.abort(), TIMEOUT);
        try {
          const res = await fetch(COUNTER_URL + '/get?path=' + encodeURIComponent(path), {
            signal: controller.signal,
          });
          if (!res.ok) throw new Error('bad status');
          const data = await res.json();
          const val = el.getAttribute('data-counter') === 'total' ? data.total : data.count;
          if (typeof val === 'number') el.textContent = val.toLocaleString('zh-CN');
        } catch (e) {
          el.textContent = '—';
        } finally {
          clearTimeout(timer);
        }
      });
    })();
  </script>
</Base>
