---
import { url } from '../utils/url';
import Base from '../layouts/Base.astro';
import { getNotesWithWords } from '../utils/content';
import Lucide from '../components/Lucide.astro';

const notes = await getNotesWithWords();
const totalWords = notes.reduce((sum, note) => sum + note.words, 0);
const averageWords = notes.length ? Math.round(totalWords / notes.length) : 0;
---

<Base title="统计" description="万数屋的访问量与字数统计。">
  <section class="reveal flex items-start gap-5">
    <div class="min-w-0 flex-1">
      <p class="kana mb-1">STATS · すうじ</p>
      <span class="pill"><Lucide name="chart" size={14} class="text-[#ff6f9c]" /> 统计</span>
      <h1 class="mt-3 font-cute text-3xl md:text-4xl">这间屋子的数据</h1>
      <p class="mt-3 text-[#574d5f]">来客多少，写了多少字，一目了然。</p>
    </div>
    <img
      src={url('/assets/art/hero-star.webp')}
      alt=""
      class="mt-1 hidden h-24 w-24 shrink-0 rounded-[14px] border-[1.5px] border-[#2b2333] object-cover object-top md:block"
      loading="lazy"
    />
  </section>

  <section class="mt-8 grid gap-4 sm:grid-cols-3">
    <div class="card p-6 text-center">
      <p class="text-sm text-[#7a6b74]">总访问量（PV）</p>
      <p class="mt-2 font-cute text-4xl text-[#ff5c8d]"><span id="busuanzi_value_site_pv">—</span></p>
    </div>
    <div class="card p-6 text-center">
      <p class="text-sm text-[#7a6b74]">访客数（UV）</p>
      <p class="mt-2 font-cute text-4xl text-[#33406e]"><span id="busuanzi_value_site_uv">—</span></p>
    </div>
    <div class="card p-6 text-center">
      <p class="text-sm text-[#7a6b74]">本页访问</p>
      <p class="mt-2 font-cute text-4xl text-[#3f9c7c]"><span id="busuanzi_value_page_pv">—</span></p>
    </div>
  </section>

  <section class="reveal mt-12">
    <h2 class="sec-title">字数统计</h2>
    <p class="mt-2 text-sm text-[#574d5f]">一天一点，字是攒出来的。</p>

    <div class="mt-5 grid gap-4 sm:grid-cols-3">
      <div class="card p-6 text-center">
        <p class="font-cute text-3xl text-[#ff5c8d]">{totalWords.toLocaleString('zh-CN')}</p>
        <p class="mt-1 text-sm text-[#7a6b74]">全站总字数</p>
      </div>
      <div class="card p-6 text-center">
        <p class="font-cute text-3xl text-[#33406e]">{averageWords.toLocaleString('zh-CN')}</p>
        <p class="mt-1 text-sm text-[#7a6b74]">平均每篇</p>
      </div>
      <div class="card p-6 text-center">
        <p class="font-cute text-3xl text-[#3f9c7c]">{notes.length}</p>
        <p class="mt-1 text-sm text-[#7a6b74]">笔记篇数</p>
      </div>
    </div>

    <div class="card mt-5 overflow-hidden">
      <table class="w-full text-sm">
        <thead class="bg-[#fff7fa] text-[#574d5f]">
          <tr>
            <th class="px-5 py-3 text-left font-normal">篇目</th>
            <th class="px-5 py-3 text-right font-normal">字数</th>
          </tr>
        </thead>
        <tbody>
          {
            notes.map((note) => (
              <tr class="border-t border-[#f2e2d6]">
                <td class="px-5 py-3">{note.data.title}</td>
                <td class="px-5 py-3 text-right text-[#7a6b74]">{note.words}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </section>

  <script is:inline>
    (() => {
      const host = location.hostname;
      const isLocal =
        host === "localhost" || host === "127.0.0.1" || host === "::1" || location.protocol === "file:";
      if (!isLocal) return;

      const ids = ["busuanzi_value_site_pv", "busuanzi_value_site_uv", "busuanzi_value_page_pv"];
      let ticks = 0;
      const sanitize = () => {
        for (const id of ids) {
          const el = document.getElementById(id);
          if (el) el.textContent = "—";
        }
      };
      sanitize();
      const timer = setInterval(() => {
        ticks += 1;
        sanitize();
        if (ticks >= 8) clearInterval(timer);
      }, 700);
    })();
  </script>
  <script is:inline defer src="https://busuanzi.ibruce.info/busuanzi/2.3/busuanzi.pure.mini.js"></script>
</Base>
