---
import Base from '../layouts/Base.astro';
import Lucide from '../components/Lucide.astro';
---

<Base title="留言" description="在万数屋留一句话。">
  <section class="reveal flex items-start gap-5">
    <div class="min-w-0 flex-1">
      <p class="kana mb-1">GUESTBOOK · メッセージ</p>
      <span class="pill"><Lucide name="message" size={14} class="text-[#ff6f9c]" /> 留言</span>
      <h1 class="mt-3 font-cute text-3xl md:text-4xl">随便说点什么</h1>
      <p class="mt-3 text-[#574d5f]">留言簿就放在门口，想写什么都可以。</p>
    </div>
    <img
      src="/assets/art/chibi-cat.webp"
      alt=""
      class="mt-1 hidden h-24 w-24 shrink-0 rounded-[14px] border-[1.5px] border-[#2b2333] object-cover object-top md:block"
      loading="lazy"
    />
  </section>

  <div class="reveal card mt-10 p-7">
    <label class="block">
      <span class="text-sm text-[#7a6b74]">昵称</span>
      <input
        type="text"
        disabled
        placeholder="暂不可用"
        class="mt-2 h-11 w-full cursor-not-allowed rounded-[10px] border-[1.5px] border-[#2b2333]/30 bg-[#fffaf4] px-4 text-sm text-[#a898a2] placeholder:text-[#c0b3bb]"
      />
    </label>

    <label class="mt-4 block">
      <span class="text-sm text-[#7a6b74]">想说的话</span>
      <textarea
        disabled
        rows="4"
        placeholder="暂不可用"
        class="mt-2 w-full cursor-not-allowed resize-none rounded-[10px] border-[1.5px] border-[#2b2333]/30 bg-[#fffaf4] px-4 py-3 text-sm text-[#a898a2] placeholder:text-[#c0b3bb]"
      ></textarea>
    </label>

    <div class="mt-5 flex items-center justify-between gap-4">
      <p class="text-xs text-[#7a6b74]">第一句留给你</p>
      <button type="button" disabled class="btn btn-solid cursor-not-allowed opacity-60">暂不可用</button>
    </div>
  </div>

  <div class="mt-10 flex flex-col items-center gap-2 text-center">
    <span class="text-[#b9a8f0]"><Lucide name="moon" size={30} /></span>
    <p class="text-sm text-[#7a6b74]">还没有留言，空着也挺好。</p>
  </div>
</Base>
