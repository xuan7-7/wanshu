---
import { url } from '../utils/url';
import Base from '../layouts/Base.astro';
import Lucide from '../components/Lucide.astro';
import SumTitle from '../components/SumTitle.astro';

const poem = `人生视频，时光进度，
思绪宛如网速，遇到挫折莫怕，
只是思绪放假，待到思绪归来，
网速一如既往，视频依然前放，
人生依旧宛如从前，一时卡顿影响观感，
可人生不该因此颓废，
幸得来此人间游，不该枉此走一遭。`;

const cards = [
  { icon: 'book', title: '∑数屋', desc: '知识、随记、碎碎念与灵感。', href: '/notes/' },
  { icon: 'moon', title: '万数日记', desc: '按时间排列的碎碎念，想到哪写到哪。', href: '/diary/' },
  { icon: 'camera', title: '摄影分享', desc: '相框已经备好，专等好看的光。', href: '/photos/' },
];
---

<Base title="关于" description="关于七七与万数屋。">
  <section class="reveal relative overflow-hidden rounded-[1.8rem] md:min-h-[330px]">
    <img
      src={url('/assets/about-hero.webp')}
      alt=""
      aria-hidden="true"
      class="pointer-events-none absolute inset-0 h-full w-full object-cover object-[72%_50%] md:object-[50%_0%]"
    />
    <div class="relative p-7 md:p-10">
      <div>
        <span class="pill"><Lucide name="cat" size={14} class="text-[#ff6f9c]" /> 关于</span>
        <h1 class="mt-4 font-cute text-3xl md:text-4xl">七七的万数屋</h1>
        <p class="mt-3 max-w-lg leading-relaxed text-[#6d5d63]">
          一间放知识、日子与光的小屋子。名字取自「万物有数」——日子有数，题目有数，喜欢的东西也有数。
        </p>
      </div>
    </div>
  </section>

  <section class="reveal card mt-6 overflow-hidden">
    <div class="flex items-center gap-3 border-b border-[#fff0f6] bg-[#fffafc] px-6 py-4">
      <span class="text-[#7fbf9a]"><Lucide name="leaf" size={20} /></span>
      <h2 class="font-cute text-xl">一首诗</h2>
    </div>
    <div class="px-6 py-8 md:px-10">
      <p class="whitespace-pre-line font-cute text-lg leading-loose text-[#4b4056] md:text-xl">{poem}</p>
      <p class="mt-6 text-right text-sm text-[#b6a8bd]">来源：未知</p>
    </div>
  </section>

  <section class="mt-6 grid gap-4 sm:grid-cols-3">
    {
      cards.map((card, index) => (
        <a href={url(card.href)} class="reveal card card-lift p-6" style={`transition-delay: ${index * 55}ms`}>
          <p class="w-fit text-[#ff6f9c]"><Lucide name={card.icon} size={22} /></p>
          <h3 class="mt-2 font-cute text-lg">{card.title === '∑数屋' ? <SumTitle /> : card.title}</h3>
          <p class="mt-1 text-sm text-[#8a7a80]">{card.desc}</p>
        </a>
      ))
    }
  </section>
</Base>
