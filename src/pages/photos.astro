---
import Base from '../layouts/Base.astro';
import { url } from '../utils/url';
import Lucide from '../components/Lucide.astro';

const groups = [
  {
    id: 'portrait',
    label: '竖版',
    kana: 'PORTRAIT',
    layout: 'three',
    shots: [
      { src: '/assets/photos/sunset-frame-01.webp', alt: '黄昏时分，钢结构之间的一线夕阳', label: '黄昏 · 一', date: '2026 · 11' },
    ],
  },
  {
    id: 'landscape',
    label: '横版',
    kana: 'LANDSCAPE',
    layout: 'three',
    shots: [
      { src: '/assets/photos/sunset-frame-02.webp', alt: '天边的晚霞与远处的楼影', label: '黄昏 · 二', date: '2026 · 11' },
    ],
  },
];
---

<Base title="摄影分享" description="七七拍下的一些光。">
  <section class="reveal flex items-start gap-5">
    <div class="min-w-0 flex-1">
      <p class="kana mb-1">PHOTO · しゃしん</p>
      <span class="pill"><Lucide name="camera" size={14} class="text-[#ff6f9c]" /> 摄影分享</span>
      <h1 class="mt-3 font-cute text-[clamp(1.8rem,4vw,2.4rem)]">相框已经挂好了</h1>
      <p class="mt-3 max-w-xl text-[#574d5f]">拍到好看的光就挂上来。</p>
    </div>
  </section>

  <!-- 两个小栏目，切换查看 -->
  <div class="reveal mt-10 flex gap-2" role="tablist" aria-label="摄影分类">
    {
      groups.map((group, index) => (
        <button
          type="button"
          role="tab"
          id={`tab-${group.id}`}
          aria-controls={`panel-${group.id}`}
          aria-selected={index === 0 ? 'true' : 'false'}
          data-tab={group.id}
          class:list={[
            'rounded-full border-[1.5px] border-[#2b2333] px-4 py-1.5 font-cute text-sm transition-colors duration-150',
            index === 0 ? 'bg-[#ff9fbf] text-[#2b2333]' : 'bg-white text-[#574d5f]',
          ]}
        >
          {group.label}
          <span class="ml-1 text-[0.7rem] text-[#7a6b74]">{group.kana}</span>
        </button>
      ))
    }
  </div>

  {
    groups.map((group, index) => (
      <section
        id={`panel-${group.id}`}
        role="tabpanel"
        aria-labelledby={`tab-${group.id}`}
        class:list={[index === 0 ? '' : 'hidden', 'reveal mt-6']}
      >
        <div
          class:list={[
            'grid gap-5',
            group.layout === 'three' ? 'grid-cols-2 md:grid-cols-3' : 'grid-cols-1',
          ]}
        >
          {group.shots.map((shot) => (
            <figure class="card p-3">
              <img
                src={url(shot.src)}
                alt={shot.alt}
                class:list={[
                  'mx-auto h-auto max-w-full rounded-[10px]',
                  group.layout === 'three' ? 'max-h-[clamp(260px,46vh,520px)] w-auto' : 'w-full',
                ]}
                loading="lazy"
              />
              <figcaption class="mt-3 flex items-center justify-between px-1 pb-1">
                <span class="font-cute text-sm text-[#574d5f]">{shot.label}</span>
                <span class="text-xs text-[#a898a2]">{shot.date}</span>
              </figcaption>
            </figure>
          ))}
        </div>
      </section>
    ))
  }

  <script>
    const tabs = document.querySelectorAll<HTMLButtonElement>('[data-tab]');
    const panels = document.querySelectorAll<HTMLElement>('[role="tabpanel"]');
    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const id = tab.dataset.tab;
        tabs.forEach((t) => {
          const on = t === tab;
          t.setAttribute('aria-selected', on ? 'true' : 'false');
          t.classList.toggle('bg-[#ff9fbf]', on);
          t.classList.toggle('text-[#2b2333]', on);
          t.classList.toggle('bg-white', !on);
          t.classList.toggle('text-[#574d5f]', !on);
        });
        panels.forEach((panel) => {
          panel.classList.toggle('hidden', panel.id !== `panel-${id}`);
        });
      });
    });
  </script>
</Base>
