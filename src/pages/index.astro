---
import { url } from '../utils/url';
import Base from '../layouts/Base.astro';
import { getNotesWithWords, getDiaryEntries, formatDate } from '../utils/content';
import Lucide from '../components/Lucide.astro';

const notes = await getNotesWithWords();
const diary = await getDiaryEntries();

const totalWords = notes.reduce((sum, note) => sum + note.words, 0);
const latestDiary = diary[0];

const sections = [
  {
    href: '/notes/',
    title: '知识笔记',
    desc: '专升本高数的复习记录',
    img: '/assets/art/star-portrait.webp',
  },
  {
    href: '/diary/',
    title: '万数日记',
    desc: '一些没头没尾的碎碎念',
    img: '/assets/art/moon-cat.webp',
  },
  {
    href: '/photos/',
    title: '摄影分享',
    desc: '相框已经挂好，等光来',
    img: '/assets/art/camera-girl.webp',
  },
];

const more = [
  { href: '/archive/', label: '归档', desc: '按年份翻旧文' },
  { href: '/tags/', label: '标签', desc: '按主题找笔记' },
  { href: '/links/', label: '友链', desc: '路过的小屋' },
  { href: '/guestbook/', label: '留言', desc: '随便说点什么' },
];
---

<Base title="首页">
  <section class="reveal relative left-1/2 w-screen -translate-x-1/2 overflow-hidden bg-[#101328]">
    <img
      src={url('/assets/art/hero-star.webp')}
      alt="在夜空下作画的少女"
      class="absolute inset-0 h-full w-full object-cover object-[58%_40%]"
    />
    <div class="absolute inset-0 bg-[linear-gradient(96deg,rgba(10,12,30,0.97)_0%,rgba(10,12,30,0.92)_34%,rgba(10,12,30,0.55)_56%,rgba(10,12,30,0.08)_74%,rgba(10,12,30,0)_88%)]"></div>
    <div class="halftone absolute inset-0"></div>

    <div class="relative mx-auto flex min-h-[500px] max-w-5xl flex-col justify-center px-5 py-16 md:min-h-[560px]">
      <span class="kana text-[#ffc2d6]">YOROKONDE · ようこそ万数屋へ</span>
      <h1 class="mt-3 font-cute text-5xl leading-[1.15] text-white [text-shadow:0_2px_18px_rgba(8,10,26,0.75)] md:text-7xl">
        七七的<br class="md:hidden" /><span class="text-[#ff9fbf]">万数</span>屋
      </h1>
      <p class="mt-4 max-w-sm text-[15px] leading-relaxed text-[#efe6f7]/85">
        知识、日子与光，都收在这间小屋子里。<br />万物有数，数不清的部分就先记在这里。
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a class="btn btn-solid" href={url('/notes/')}>去看看笔记</a>
        <a class="btn btn-ghost" href={url('/about/')}>认识七七</a>
      </div>
    </div>

    <div class="pointer-events-none absolute bottom-6 right-6 hidden md:block">
      <div class="bubble !bg-white/95 font-cute text-[13px] text-[#2b2333]">要一起复习吗？</div>
    </div>
    <img
      src={url('/assets/art/chibi-cat.webp')}
      alt="七七"
      class="pointer-events-none absolute -bottom-2 right-6 hidden h-36 w-auto rounded-t-[18px] border-[1.5px] border-b-0 border-[#2b2333] bg-[#f6e6d0] md:block"
    />
  </section>

  <section class="mt-12 grid gap-5 sm:grid-cols-3">
    {
      sections.map((section, index) => (
        <a
          href={url(section.href)}
          class="reveal card card-lift overflow-hidden"
          style={`transition-delay: ${index * 60}ms`}
        >
          <div class="h-32 overflow-hidden">
            <img src={url(section.img)} alt="" class="h-full w-full object-cover object-center" loading="lazy" />
          </div>
          <div class="p-5">
            <h2 class="font-cute text-lg">{section.title}</h2>
            <p class="mt-1 text-sm text-[#8a7a80]">{section.desc}</p>
          </div>
        </a>
      ))
    }
  </section>

  <section class="mt-16">
    <div class="reveal flex items-end justify-between">
      <p class="kana">NOTES · ノート</p><h2 class="sec-title">最新的笔记</h2>
      <a href={url('/notes/')} class="text-sm text-[#ff6f9c] hover:underline">全部 →</a>
    </div>

    <div class="mt-4 grid gap-4 md:grid-cols-3">
      {
        notes.map((note, index) => (
          <a
            href={url(`/notes/${note.id}/`)}
            class="reveal card card-lift flex flex-col p-6"
            style={`transition-delay: ${index * 70}ms`}
          >
            <span class="tag">{note.data.chapter}</span>
            <h3 class="mt-3 font-cute text-lg leading-snug">{note.data.title}</h3>
            <p class="mt-2 flex-1 text-sm leading-relaxed text-[#8a7a80]">{note.data.summary}</p>
            <span class="mt-4 text-xs text-[#b6a8bd]">{note.words} 字</span>
          </a>
        ))
      }
    </div>
  </section>

  <section class="mt-16 grid gap-5 md:grid-cols-2">
    <a href={url('/diary/')} class="reveal card card-lift block overflow-hidden">
      <div class="flex items-center justify-between px-6 pt-5">
        <h2 class="font-cute text-xl">万数日记</h2>
        <span class="text-sm text-[#ff6f9c]">时间线 →</span>
      </div>
      {
        latestDiary && (
          <div class="mt-4 flex items-center gap-4 px-6 pb-6">
            <img
              src={url('/assets/art/moon-cat.webp')}
              alt=""
              class="h-20 w-20 shrink-0 rounded-2xl object-cover object-center"
              loading="lazy"
            />
            <div>
              <p class="text-xs text-[#b6a8bd]">
                {formatDate(latestDiary.data.date)} · {latestDiary.data.mood}
              </p>
              <p class="mt-1 font-cute text-lg">{latestDiary.data.title}</p>
            </div>
          </div>
        )
      }
    </a>

    <a href={url('/photos/')} class="reveal card card-lift block overflow-hidden">
      <div class="flex items-center justify-between px-6 pt-5">
        <h2 class="font-cute text-xl">摄影分享</h2>
        <span class="text-sm text-[#ff6f9c]">去看看 →</span>
      </div>
      <div class="mt-4 flex items-center gap-4 px-6 pb-6">
        <div class="grid h-20 w-20 shrink-0 place-items-center rounded-2xl border-2 border-dashed border-[#ffe0ea] bg-[#fffafc]">
          <span class="text-[#ffc2d6]"><Lucide name="image" size={26} /></span>
        </div>
        <p class="text-sm leading-relaxed text-[#8a7a80]">照片还在冲洗，相框先挂好，等哪天撞见好看的光。</p>
      </div>
    </a>
  </section>

  <section class="mt-16">
    <p class="kana reveal">MORE · そのほか</p><h2 class="reveal sec-title">逛一逛</h2>
    <div class="mt-4 grid gap-3 sm:grid-cols-4">
      {
        more.map((item, index) => (
          <a
            href={url(item.href)}
            class="reveal card card-lift p-5"
            style={`transition-delay: ${index * 50}ms`}
          >
            <p class="font-cute text-lg">{item.label}</p>
            <p class="mt-1 text-xs text-[#9b8a90]">{item.desc}</p>
          </a>
        ))
      }
    </div>
  </section>

  <section class="reveal mt-16 grid gap-6 rounded-[18px] border border-[#f1e3d8] bg-white/70 p-7 sm:grid-cols-3">
    <div class="text-center">
      <p class="font-cute text-3xl text-[#ff6f9c]">{totalWords.toLocaleString('zh-CN')}</p>
      <p class="mt-1 text-sm text-[#8a7a80]">全站总字数</p>
    </div>
    <div class="text-center">
      <p class="font-cute text-3xl text-[#5b8bd0]">{notes.length}</p>
      <p class="mt-1 text-sm text-[#8a7a80]">知识笔记</p>
    </div>
    <div class="text-center">
      <p class="font-cute text-3xl text-[#4fa982]">{diary.length}</p>
      <p class="mt-1 text-sm text-[#8a7a80]">万数日记</p>
    </div>
  </section>
</Base>
