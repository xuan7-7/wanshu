---
import { url } from '../utils/url';
import Base from '../layouts/Base.astro';
import { getNotesWithWords, getDiaryEntries, formatDate } from '../utils/content';
import Lucide from '../components/Lucide.astro';

const notes = await getNotesWithWords();
const diary = await getDiaryEntries();

const totalWords = notes.reduce((sum, note) => sum + note.words, 0);
const averageWords = notes.length ? Math.round(totalWords / notes.length) : 0;
const latestDiary = diary[0];

const sections = [
  {
    href: '/notes/',
    title: '知识笔记',
    desc: '专升本高数的复习记录',
    img: '/assets/art/star-portrait.webp',
  },
  {
    href: '/diary/',
    title: '万数日记',
    desc: '一些没头没尾的碎碎念',
    img: '/assets/art/moon-cat.webp',
  },
  {
    href: '/photos/',
    title: '摄影分享',
    desc: '相框已经挂好，等光来',
    img: '/assets/art/camera-girl.webp',
  },
];

const more = [
  { href: '/archive/', label: '归档', desc: '按年份翻旧文' },
  { href: '/tags/', label: '标签', desc: '按主题找笔记' },
  { href: '/links/', label: '友链', desc: '路过的小屋' },
];
---

<Base title="首页">
  <section class="reveal relative overflow-hidden">
    <div class="relative mx-auto flex min-h-[clamp(360px,52vw,560px)] max-w-5xl flex-col justify-center px-[clamp(1rem,4vw,1.5rem)] py-16">
      <span class="kana text-[#b8467a]">YOROKONDE · ようこそ万数屋へ</span>
      <h1 class="mt-3 font-cute text-[clamp(2.5rem,5.4vw,4.6rem)] leading-[1.15] text-[#2b2333]">
        七七的<br class="md:hidden" /><span class="text-[#ff9fbf]">万数</span>屋
      </h1>
      <p class="mt-4 max-w-sm text-[15px] leading-relaxed text-[#4b4056]">
        知识、日子与光，都收在这间小屋子里。<br />万物有数，数不清的部分就先记在这里。
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a class="btn btn-solid" href={url('/notes/')}>去看看笔记</a>
        <a class="btn btn-ghost" href={url('/about/')}>认识七七</a>
      </div>
    </div>

    <div class="pointer-events-none absolute bottom-6 right-6 hidden md:block">
      <div class="bubble !bg-white/95 font-cute text-[13px] text-[#2b2333]">要一起复习吗？</div>
    </div>
  </section>

  <section class="mt-10 grid grid-cols-3 gap-2.5 sm:mt-12 sm:gap-5">
    {
      sections.map((section, index) => (
        <a
          href={url(section.href)}
          class="reveal card card-lift overflow-hidden"
          style={`transition-delay: ${index * 60}ms`}
        >
          <div class="h-16 overflow-hidden sm:h-32">
            <img src={url(section.img)} alt="" class="h-full w-full object-cover object-center" loading="lazy" />
          </div>
          <div class="p-2 sm:p-5">
            <h2 class="font-cute text-[12px] leading-tight sm:text-lg">{section.title}</h2>
            <p class="mt-1 hidden text-sm text-[#8a7a80] sm:block">{section.desc}</p>
          </div>
        </a>
      ))
    }
  </section>

  <section class="mt-16">
    <div class="reveal flex items-end justify-between">
      <p class="kana">NOTES · ノート</p><h2 class="sec-title">最新的笔记</h2>
      <a href={url('/notes/')} class="text-sm text-[#ff6f9c] hover:underline">全部 →</a>
    </div>

    <div class="mt-4 grid grid-cols-3 gap-2.5 md:gap-4">
      {
        notes.map((note, index) => (
          <a
            href={url(`/notes/${note.id}/`)}
            class="reveal card card-lift flex flex-col p-2 sm:p-6"
            style={`transition-delay: ${index * 70}ms`}
          >
            <span class="tag hidden sm:inline-block">{note.data.chapter}</span>
            <h3 class="mt-0 font-cute text-[12px] leading-tight sm:mt-3 sm:text-lg sm:leading-snug">{note.data.title}</h3>
            <p class="mt-2 hidden flex-1 text-sm leading-relaxed text-[#8a7a80] sm:block">{note.data.summary}</p>
            <span class="mt-2 text-[10px] text-[#b6a8bd] sm:mt-4 sm:text-xs">{note.words} 字</span>
          </a>
        ))
      }
    </div>
  </section>
<section class="mt-16">
    <p class="kana reveal">MORE · そのほか</p><h2 class="reveal sec-title">逛一逛</h2>
    <div class="mt-4 grid grid-cols-3 gap-2.5 sm:grid-cols-4 sm:gap-3">
      {
        more.map((item, index) => (
          <a
            href={url(item.href)}
            class="reveal card card-lift p-2 sm:p-5"
            style={`transition-delay: ${index * 50}ms`}
          >
            <p class="font-cute text-[12px] leading-tight sm:text-lg">{item.label}</p>
            <p class="mt-1 hidden text-xs text-[#9b8a90] sm:block">{item.desc}</p>
          </a>
        ))
      }
    </div>
  </section>
  <!-- 悬浮统计窗：可收起成头像按钮 -->
  <div id="stats-widget" class="fixed right-3 top-1/2 z-[60] -translate-y-1/2 touch-none">
    <section
      id="stats-panel"
      class="card w-[13.5rem] origin-bottom-right p-4 transition-transform duration-200"
    >
      <div class="flex items-center justify-between">
        <p class="font-cute text-sm text-[#2b2333]">笔记的数字</p>
        <button
          type="button"
          id="stats-collapse"
          aria-label="收起"
          class="grid h-6 w-6 place-items-center rounded-full border border-[#f2e2d6] text-[#7a6b74] hover:text-[#ff6f9c]"
        >
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M6 12h12" /></svg>
        </button>
      </div>
      <dl class="mt-3 space-y-2 text-xs">
        <div class="flex items-baseline justify-between">
          <dt class="text-[#7a6b74]">全站总字数</dt>
          <dd class="font-cute text-sm text-[#ff5c8d] tabular-nums">{totalWords.toLocaleString('zh-CN')}</dd>
        </div>
        <div class="flex items-baseline justify-between">
          <dt class="text-[#7a6b74]">平均每篇</dt>
          <dd class="font-cute text-sm text-[#33406e] tabular-nums">{averageWords.toLocaleString('zh-CN')}</dd>
        </div>
        <div class="flex items-baseline justify-between">
          <dt class="text-[#7a6b74]">笔记篇数</dt>
          <dd class="font-cute text-sm text-[#3f9c7c] tabular-nums">{notes.length}</dd>
        </div>
      </dl>
    </section>

    <button
      type="button"
      id="stats-open"
      aria-label="展开统计"
      class="hidden h-12 w-12 overflow-hidden rounded-[14px] border-[1.5px] border-[#2b2333] bg-[#fffaf5] shadow-[4px_4px_0_rgba(43,35,51,0.16)]"
    >
      <img src={url('/assets/avatar.webp')} alt="" draggable="false" class="pointer-events-none h-full w-full select-none object-cover" />
    </button>
  </div>

  <script>
    (() => {
      const wrap = document.getElementById('stats-widget');
      const panel = document.getElementById('stats-panel');
      const openBtn = document.getElementById('stats-open');
      const closeBtn = document.getElementById('stats-collapse');
      if (!wrap || !panel || !openBtn || !closeBtn) return;

      const COLLAPSE_KEY = 'wanshu-stats-collapsed';
      const POS_KEY = 'wanshu-stats-pos';

      /* 位置工具（全部先声明，避免初始化时引用未定义） */
      const clampPos = (x: number, y: number) => {
        const maxX = window.innerWidth - wrap.offsetWidth - 8;
        const maxY = window.innerHeight - wrap.offsetHeight - 8;
        return { x: Math.min(Math.max(8, x), Math.max(8, maxX)), y: Math.min(Math.max(8, y), Math.max(8, maxY)) };
      };
      const applyPos = (x: number, y: number) => {
        const p = clampPos(x, y);
        wrap.style.left = p.x + 'px';
        wrap.style.top = p.y + 'px';
        wrap.style.right = 'auto';
        wrap.style.bottom = 'auto';
        wrap.style.transform = 'none';
      };
      const savePos = () => {
        try {
          localStorage.setItem(POS_KEY, JSON.stringify({ x: parseFloat(wrap.style.left), y: parseFloat(wrap.style.top) }));
        } catch {}
      };
      const withSnap = (fn: () => void) => {
        wrap.style.transition = 'left 200ms ease, top 200ms ease';
        fn();
        setTimeout(() => { wrap.style.transition = ''; }, 220);
      };
      const snapToEdge = () => {
        const r = wrap.getBoundingClientRect();
        const cx = r.left + r.width / 2;
        const targetX = cx < window.innerWidth / 2 ? 8 : window.innerWidth - r.width - 8;
        withSnap(() => {
          wrap.style.left = targetX + 'px';
          wrap.style.top = r.top + 'px';
          wrap.style.right = 'auto';
          wrap.style.bottom = 'auto';
          wrap.style.transform = 'none';
        });
        savePos();
      };

      const setCollapsed = (collapsed: boolean) => {
        panel.classList.toggle('hidden', collapsed);
        openBtn.classList.toggle('hidden', !collapsed);
        try { localStorage.setItem(COLLAPSE_KEY, collapsed ? '1' : '0'); } catch {}
        if (collapsed) {
          snapToEdge();
        } else if (wrap.style.left) {
          withSnap(() => applyPos(parseFloat(wrap.style.left), parseFloat(wrap.style.top)));
        }
      };

      /* 拖动 */
      let drag: { id: number; sx: number; sy: number; ox: number; oy: number } | null = null;
      let dragged = false;
      let suppressClick = false;

      const onMove = (e: PointerEvent) => {
        if (!drag || e.pointerId !== drag.id) return;
        const dx = e.clientX - drag.sx;
        const dy = e.clientY - drag.sy;
        if (!dragged && Math.abs(dx) < 5 && Math.abs(dy) < 5) return;
        dragged = true;
        e.preventDefault();
        applyPos(drag.ox + dx, drag.oy + dy);
      };
      const onUp = (e: PointerEvent) => {
        if (!drag || e.pointerId !== drag.id) return;
        window.removeEventListener('pointermove', onMove);
        window.removeEventListener('pointerup', onUp);
        window.removeEventListener('pointercancel', onUp);
        if (dragged) {
          suppressClick = true;
          if (panel.classList.contains('hidden')) snapToEdge();
          else savePos();
          setTimeout(() => { suppressClick = false; }, 0);
        }
        dragged = false;
        drag = null;
      };

      wrap.addEventListener('pointerdown', (e) => {
        const r = wrap.getBoundingClientRect();
        drag = { id: e.pointerId, sx: e.clientX, sy: e.clientY, ox: r.left, oy: r.top };
        dragged = false;
        window.addEventListener('pointermove', onMove, { passive: false });
        window.addEventListener('pointerup', onUp);
        window.addEventListener('pointercancel', onUp);
      });

      /* 按钮：先绑定，再做初始化 */
      closeBtn.addEventListener('click', (e) => {
        if (suppressClick) { e.preventDefault(); e.stopPropagation(); return; }
        setCollapsed(true);
      });
      openBtn.addEventListener('click', (e) => {
        if (suppressClick) { e.preventDefault(); e.stopPropagation(); return; }
        setCollapsed(false);
      });

      window.addEventListener('resize', () => {
        if (wrap.style.left) applyPos(parseFloat(wrap.style.left), parseFloat(wrap.style.top));
      });

      /* 初始化 */
      let collapsed = false;
      try { collapsed = localStorage.getItem(COLLAPSE_KEY) === '1'; } catch {}
      try {
        const saved = localStorage.getItem(POS_KEY);
        if (saved) {
          const p = JSON.parse(saved);
          if (typeof p.x === 'number' && typeof p.y === 'number') applyPos(p.x, p.y);
        }
      } catch {}
      setCollapsed(collapsed);
    })();
  </script></Base>
