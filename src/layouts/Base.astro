---
import '../styles/global.css';
import Lucide from '../components/Lucide.astro';

interface Props {
  title: string;
  description?: string;
}

const { title, description = '七七的万数屋 · 知识、日子与光。' } = Astro.props;
const path = Astro.url.pathname;

const nav = [
  { href: '/', label: '首页', icon: 'home' as const },
  { href: '/notes/', label: '知识笔记', icon: 'book' as const },
  { href: '/diary/', label: '万数日记', icon: 'moon' as const },
  { href: '/photos/', label: '摄影分享', icon: 'camera' as const },
  { href: '/guestbook/', label: '留言', icon: 'message' as const },
  { href: '/about/', label: '关于', icon: 'cat' as const },
];

const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · 七七的万数屋</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <div class="sakura-layer" aria-hidden="true">
      <i class="sakura" style="left:6%;animation-duration:8s;animation-delay:0s;--drift:50px"></i>
      <i class="sakura" style="left:18%;animation-duration:9.2s;animation-delay:0.35s;--drift:-40px"></i>
      <i class="sakura" style="left:31%;animation-duration:7.6s;animation-delay:0.7s;--drift:60px"></i>
      <i class="sakura" style="left:47%;animation-duration:8.8s;animation-delay:0.15s;--drift:-55px"></i>
      <i class="sakura" style="left:66%;animation-duration:9.8s;animation-delay:0.9s;--drift:45px"></i>
      <i class="sakura" style="left:84%;animation-duration:8.2s;animation-delay:0.5s;--drift:-50px"></i>
      <i class="sakura" style="left:94%;animation-duration:9.4s;animation-delay:1.1s;--drift:35px"></i>
    </div>
    <div class="fixed inset-x-0 top-3 z-40 flex justify-center px-4">
      <nav
        class="flex w-full max-w-5xl items-center justify-between gap-3 rounded-full border border-white/80 bg-[#fffaf5]/70 px-4 py-2.5 shadow-[0_10px_30px_-18px_rgba(60,40,80,0.55)] backdrop-blur-xl backdrop-saturate-150"
      >
        <a href="/" class="flex shrink-0 items-center gap-2.5">
          <span
            class="grid h-8 w-8 place-items-center rounded-full bg-[radial-gradient(circle_at_32%_30%,#fff,#ff9fbf_70%)] text-sm shadow-[inset_0_0_0_2px_rgba(255,255,255,0.8)]"
          >
            ✦
          </span>
          <span class="hidden whitespace-nowrap font-cute text-lg sm:inline">七七的万数屋</span>
        </a>

        <div class="flex flex-wrap items-center justify-end gap-0.5 text-[13px] sm:text-sm">
          {
            nav.map((item) => (
              <a
                href={item.href}
                class:list={[
                  'inline-flex items-center gap-1.5 whitespace-nowrap rounded-full px-2.5 py-1.5 transition-colors duration-150 sm:px-3',
                  isActive(item.href)
                    ? 'bg-[#2f2740] text-white'
                    : 'text-[#6d6280] hover:bg-white/80 hover:text-[#ff6f9c]',
                ]}
              >
                <Lucide name={item.icon} size={15} class="hidden shrink-0 sm:block" />
                {item.label}
              </a>
            ))
          }
        </div>
      </nav>
    </div>

    <main class="mx-auto w-full max-w-5xl px-5 pb-16 pt-24">
      <slot />
    </main>

    <footer class="border-t border-[#ffe7d3] bg-[#fffaf5] py-9 text-center text-sm text-[#9b8a90]">
      <p class="font-cute text-base text-[#c98aa8]">✿ 万物有数 ✿</p>
      <p class="mt-1">七七的万数屋 · 知识、日子与光</p>
      <p class="mt-4 flex flex-wrap justify-center gap-x-4 gap-y-1 text-xs">
        <a class="hover:text-[#ff6f9c]" href="/archive/">归档</a>
        <a class="hover:text-[#ff6f9c]" href="/tags/">标签</a>
        <a class="hover:text-[#ff6f9c]" href="/links/">友链</a>
        <a class="hover:text-[#ff6f9c]" href="/stats/">统计</a>
      </p>
    </footer>

    <script>
      const targets = document.querySelectorAll<HTMLElement>('.reveal');
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (reduce || !('IntersectionObserver' in window)) {
        targets.forEach((el) => el.classList.add('is-visible'));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.1, rootMargin: '0px 0px -30px 0px' }
        );
        targets.forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>
