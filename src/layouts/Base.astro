---
import { url } from '../utils/url';
import '../styles/global.css';
import Lucide from '../components/Lucide.astro';
import visitStats from '../data/visit-stats.json';
import zcoolFont from '../assets/fonts/zcool-subset.woff2?url';

interface Props {
  title: string;
  description?: string;
}

const { title, description = '七七的万数屋 · 知识、日子与光。' } = Astro.props;
const path = Astro.url.pathname;

const nav = [
  { href: '/', label: '首页', icon: 'home' as const },
  { href: '/notes/', label: '知识笔记', icon: 'book' as const },
  { href: '/diary/', label: '万数日记', icon: 'notebook' as const },
  { href: '/photos/', label: '摄影分享', icon: 'camera' as const },
  { href: '/links/', label: '友链', icon: 'link' as const },
  { href: '/about/', label: '关于', icon: 'cat' as const },
];

const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · 七七的万数屋</title>
    <meta name="description" content={description} />
    <link rel="icon" href={url('/favicon.png')} type="image/png" />
    <link rel="apple-touch-icon" href={url('/icon-192.png')} />    <script is:inline>
      (() => {
        try {
          const KEY = 'wanshu-theme';
          const saved = localStorage.getItem(KEY);
          const sys = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
          document.documentElement.dataset.theme = saved || sys;
        } catch {
          document.documentElement.dataset.theme = 'light';
        }
      })();
    </script>    <!-- 51LA 统计（暂时停用，保留备用）
    <script charset="UTF-8" id="LA_COLLECT" src="//sdk.51.la/js-sdk-pro.min.js"></script>
    <script is:inline>LA.init({ id: '3RtpzaFqygbXeAnR', ck: '3RtpzaFqygbXeAnR' });</script>
    -->    <script is:inline>LA.init({ id: '3RtpzaFqygbXeAnR', ck: '3RtpzaFqygbXeAnR' });</script>    <script defer src="https://events.vercount.one/js"></script>
    <!-- 首屏背景预加载（按视口选择，避免多拉） -->
    <link rel="preload" as="image" href={url('/assets/bg-phone.webp')} media="(max-width: 640px)" />
    <link rel="preload" as="image" href={url('/assets/bg-desktop.webp')} media="(min-width: 1025px) and (min-aspect-ratio: 4/3)" />
    <link rel="preload" as="image" href={url('/assets/bg-ultrawide.webp')} media="(min-width: 1440px) and (min-aspect-ratio: 21/9)" />    <link rel="preload" as="font" type="font/woff2" href={zcoolFont} crossorigin="anonymous" />
  </head>
  <body>
    <div class="site-bg" aria-hidden="true">
      <picture>
        <source media="(max-width: 640px)" srcset={url('/assets/bg-phone.webp')} />
        <source media="(max-width: 1024px) and (max-aspect-ratio: 4/5)" srcset={url('/assets/bg-tablet.webp')} />
        <source media="(min-aspect-ratio: 21/9)" srcset={url('/assets/bg-ultrawide.webp')} />
        <source media="(min-aspect-ratio: 4/3)" srcset={url('/assets/bg-desktop.webp')} />
        <img src={url('/assets/bg-square.webp')} alt="" loading="eager" decoding="async" fetchpriority="high" />
      </picture>
      <span class="site-bg__scrim"></span>
    </div>

    <div class="sakura-layer" aria-hidden="true">
      <i class="sakura" style="left:6%;animation-duration:8s;animation-delay:0s;--drift:50px"></i>
      <i class="sakura" style="left:18%;animation-duration:9.2s;animation-delay:0.35s;--drift:-40px"></i>
      <i class="sakura" style="left:31%;animation-duration:7.6s;animation-delay:0.7s;--drift:60px"></i>
      <i class="sakura" style="left:47%;animation-duration:8.8s;animation-delay:0.15s;--drift:-55px"></i>
      <i class="sakura" style="left:66%;animation-duration:9.8s;animation-delay:0.9s;--drift:45px"></i>
      <i class="sakura" style="left:84%;animation-duration:8.2s;animation-delay:0.5s;--drift:-50px"></i>
      <i class="sakura" style="left:94%;animation-duration:9.4s;animation-delay:1.1s;--drift:35px"></i>
    </div>
    <div class="fixed inset-x-0 top-3 z-40 flex justify-center px-[clamp(0.75rem,3vw,1rem)]">
      <nav
        class="relative flex w-full max-w-5xl items-center justify-between gap-2 rounded-full border border-white/80 bg-[#fffaf5] px-3 py-2.5 shadow-[0_10px_30px_-18px_rgba(60,40,80,0.35)]"
      >
        <a href={url('/')} class="flex shrink-0 items-center gap-2">
          <img
            src={url('/assets/avatar.webp')}
            alt="七七"
            width="32"
            height="32"
            class="h-8 w-8 rounded-full border-[1.5px] border-[#2b2333] object-cover"
          />
          <span class="whitespace-nowrap font-cute text-base sm:text-lg">七七的万数屋</span>
        </a>

        <div class="flex items-center gap-1.5 md:gap-1">

        <!-- 平板 / 桌面：完整导航 -->
        <div class="hidden flex-wrap items-center justify-end gap-0.5 text-sm md:flex">
          {
            nav.map((item) => (
              <a
                href={url(item.href)}
                class:list={[
                  'inline-flex items-center gap-1.5 whitespace-nowrap rounded-full px-3 py-1.5 transition-colors duration-150',
                  isActive(item.href)
                    ? 'bg-[#2f2740] text-white'
                    : 'text-[#6d6280] hover:bg-white/80 hover:text-[#ff6f9c]',
                ]}
              >
                <Lucide name={item.icon} size={15} class="shrink-0" />
                {item.label}
              </a>
            ))
          }
        </div>

        <!-- 手机：首页 + 菜单按钮 -->
        <div class="flex items-center gap-1 md:hidden">
          <a
            href={url('/')}
            class:list={[
              'rounded-full px-3 py-1.5 text-sm',
              path === '/' ? 'bg-[#2f2740] text-white' : 'text-[#574d5f]',
            ]}
          >
            首页
          </a>
          <button
            type="button"
            id="nav-toggle"
            aria-expanded="false"
            aria-controls="nav-panel"
            aria-label="打开菜单"
            class="grid h-9 w-9 place-items-center rounded-full border border-[#f2e2d6] bg-white/70 text-[#574d5f]"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
              <path d="M4 7h16M4 12h16M4 17h16"></path>
            </svg>
          </button>

        </div>

        <button
          type="button"
          id="theme-toggle"
          aria-label="切换日光 / 黑暗模式"
          class="grid h-9 w-9 shrink-0 place-items-center rounded-full border border-[#f2e2d6] bg-white/70 text-[#574d5f] transition-colors duration-150 hover:text-[#b8467a]"
        >
          <span class="theme-icon theme-icon--sun"><Lucide name="sun" size={16} /></span>
          <span class="theme-icon theme-icon--moon"><Lucide name="moon" size={16} /></span>
        </button>
        </div>

        <!-- 手机：展开菜单 -->
        <div
          id="nav-panel"
          class="absolute left-0 right-0 top-[calc(100%+0.5rem)] hidden rounded-[18px] border border-[#f2e2d6] bg-[#fffaf5] p-2 shadow-[0_18px_36px_-24px_rgba(60,40,80,0.7)] md:hidden"
        >
          <div class="grid grid-cols-2 gap-1">
            {
              nav.map((item) => (
                <a
                  href={url(item.href)}
                  class:list={[
                    'flex items-center gap-2 rounded-[12px] px-3 py-2 text-sm',
                    isActive(item.href) ? 'bg-[#2f2740] text-white' : 'text-[#574d5f]',
                  ]}
                >
                  <Lucide name={item.icon} size={15} class="shrink-0" />
                  {item.label}
                </a>
              ))
            }
          </div>
          <div class="my-2 border-t border-dashed border-[#e8d6c8]"></div>
          <div class="flex flex-wrap gap-1 px-1 pb-1 text-xs">
            <a class="rounded-full bg-white px-3 py-1 text-[#7a6b74]" href={url('/archive/')}>归档</a>
            <a class="rounded-full bg-white px-3 py-1 text-[#7a6b74]" href={url('/tags/')}>标签</a>
            <a class="rounded-full bg-white px-3 py-1 text-[#7a6b74]" href={url('/stats/')}>统计</a>
          </div>
        </div>
      </nav>
    </div>

    <main class="mx-auto w-full max-w-5xl px-[clamp(1rem,4vw,1.5rem)] pb-16 pt-24">
      <slot />
    </main>

    <footer class="border-t border-[#ffe7d3] bg-[#fffaf5] py-9 text-center text-sm text-[#9b8a90]">
      <p class="font-cute text-base text-[#c98aa8]">✿ 万物有数 ✿</p>
      <p class="mt-1">七七的万数屋 · 知识、日子与光</p>

      <div class="mt-5 flex flex-wrap items-center justify-center gap-2">
        <span class="kana mr-1">传送门 · PORTAL</span>
        <a
          href="https://github.com/xuan7-7"
          target="_blank"
          rel="noopener noreferrer"
          class="pill card-lift inline-flex items-center gap-1.5 hover:text-[#b8467a]"
        >
          <Lucide name="github" size={14} class="text-[#574d5f]" />
          GitHub
          <Lucide name="external" size={11} class="text-[#a898a2]" />
        </a>
        <button
          type="button"
          id="copy-mail"
          data-mail="xuan77ei@qq.com"
          class="pill card-lift inline-flex items-center gap-1.5 hover:text-[#b8467a]"
          aria-label="复制邮箱地址"
        >
          <Lucide name="mail" size={14} class="text-[#574d5f]" />
          <span id="copy-mail-label">xuan77ei@qq.com</span>
        </button>
      </div>
      <p class="mt-4 text-xs text-[#a898a2]">
        已经在这里开了 <span data-uptime class="tabular-nums">—</span>
      </p>
      <p class="mt-1 text-xs text-[#a898a2]">
        总访客数 <span id="vercount_value_site_uv" class="tabular-nums">—</span> 人 · 总访问量 <span id="vercount_value_site_pv" class="tabular-nums">—</span> 次
        <span id="vercount_value_page_pv" class="hidden">—</span>
      </p>

      <p class="mt-4 flex flex-wrap justify-center gap-x-4 gap-y-1 text-xs">
        <a class="hover:text-[#ff6f9c]" href={url('/archive/')}>归档</a>
        <a class="hover:text-[#ff6f9c]" href={url('/tags/')}>标签</a>
        <a class="hover:text-[#ff6f9c]" href={url('/stats/')}>统计</a>
      </p>
    </footer>

    <script>
            const navToggle = document.getElementById('nav-toggle') as HTMLButtonElement | null;
      const navPanel = document.getElementById('nav-panel');
      if (navToggle && navPanel) {
        const closeNav = () => {
          navPanel.classList.add('hidden');
          navToggle.setAttribute('aria-expanded', 'false');
        };
        navToggle.addEventListener('click', () => {
          const isHidden = navPanel.classList.toggle('hidden');
          navToggle.setAttribute('aria-expanded', isHidden ? 'false' : 'true');
        });
        navPanel.addEventListener('click', (event) => {
          if ((event.target as HTMLElement).closest('a')) closeNav();
        });
        document.addEventListener('keydown', (event) => {
          if (event.key === 'Escape') closeNav();
        });
      }
const targets = document.querySelectorAll<HTMLElement>('.reveal');
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (reduce || !('IntersectionObserver' in window)) {
        targets.forEach((el) => el.classList.add('is-visible'));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.1, rootMargin: '0px 0px -30px 0px' }
        );
        targets.forEach((el) => io.observe(el));
      }
    </script>
    <script is:inline>
      (() => {
        const btn = document.getElementById('copy-mail');
        const label = document.getElementById('copy-mail-label');
        if (!btn || !label) return;
        const mail = btn.dataset.mail || '';
        const original = label.textContent || mail;
        const flash = (text) => {
          label.textContent = text;
          window.setTimeout(() => { label.textContent = original; }, 1600);
        };
        btn.addEventListener('click', async () => {
          let ok = false;
          try {
            await navigator.clipboard.writeText(mail);
            ok = true;
          } catch {
            try {
              const ta = document.createElement('textarea');
              ta.value = mail;
              ta.style.position = 'fixed';
              ta.style.opacity = '0';
              document.body.appendChild(ta);
              ta.select();
              ok = document.execCommand('copy');
              ta.remove();
            } catch {}
          }
          flash(ok ? '已复制' : '复制失败');
        });
      })();
    </script>

    <script is:inline>
      (() => {
        const KEY = 'wanshu-theme';
        const btn = document.getElementById('theme-toggle');
        if (!btn) return;
        btn.addEventListener('click', () => {
          const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
          document.documentElement.dataset.theme = next;
          try { localStorage.setItem(KEY, next); } catch {}
        });
      })();
    </script>
    <script is:inline>
      (() => {
        const START = Date.parse('2026-11-20T22:00:00Z');
        const el = document.querySelector('[data-uptime]');
        if (!el || Number.isNaN(START)) return;
        const pad = (n) => String(n).padStart(2, '0');
        const render = () => {
          const diff = Math.max(0, Date.now() - START);
          const s = Math.floor(diff / 1000);
          const d = Math.floor(s / 86400);
          const h = Math.floor((s % 86400) / 3600);
          const m = Math.floor((s % 3600) / 60);
          el.textContent = `${d} 天 ${pad(h)} 小时 ${pad(m)} 分 ${pad(s % 60)} 秒`;
        };
        render();
        setInterval(render, 1000);
      })();
    </script>
  </body>
</html>
