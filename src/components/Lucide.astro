---
import {
  BookOpen,
  Moon,
  Camera,
  Archive,
  Tag,
  Link2,
  MessageSquare,
  BarChart3,
  Cat,
  Sprout,
  Image as ImageIcon,
  Leaf,
  Sparkles,
  House,
  Github,
  Mail,
  Copy,
  Check,
  ExternalLink,
  LayoutGrid,
  List,
  NotebookPen,
  Sun,
  MoonStar,
  ChevronDown,
} from 'lucide-astro';

interface Props {
  name: 'home' | 'github' | 'mail' | 'copy' | 'check' | 'external' | 'grid' | 'list' | 'notebook' | 'sun' | 'moon' | 'book' | 'moon' | 'camera' | 'archive' | 'tag' | 'link' | 'message' | 'chart' | 'cat' | 'sprout' | 'image' | 'leaf' | 'sparkles' | 'chevron';
  size?: number;
  class?: string;
}

const { name, size = 18, class: className = '' } = Astro.props;

const icons = {
  home: House,
  github: Github,
  mail: Mail,
  copy: Copy,
  check: Check,
  external: ExternalLink,
  grid: LayoutGrid,
  list: List,
  notebook: NotebookPen,
  sun: Sun,
  moon: MoonStar,
  book: BookOpen,
  moon: Moon,
  camera: Camera,
  archive: Archive,
  tag: Tag,
  link: Link2,
  message: MessageSquare,
  chart: BarChart3,
  cat: Cat,
  sprout: Sprout,
  image: ImageIcon,
  leaf: Leaf,
  sparkles: Sparkles,
  chevron: ChevronDown,
};

const Cmp = icons[name];
---

{ Cmp ? <Cmp size={size} stroke-width={1.9} class={className} /> : null }
